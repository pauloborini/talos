# Sistema
.DS_Store
**/.DS_Store

# Vault legado (renomeado para _app-vault/)
# _app-vault/ é versionado — não ignorar

# Área de processo (.app-work é privado do Paulo: brainstorming,
# guides, auditorias, PRDs, referências de outros projetos, etc.)
# Não versionar — fica local.
.app-work/

# Config local do Claude Code
.claude/settings.local.json

# Preferências locais do Command Code (não versionar)
.commandcode/

# Build artifacts (gerados por build/build-plugins.sh em S02)
dist/
.build-stage/

# Dependências Node (MCP server em S04+)
node_modules/

# Estado de runs do orquestrador
.talos/

#Talos
.talos-smoke/
.talos

.zcode


# Backup físico do .git criado antes de git filter-repo (pré-publicação)
.git.backup-prefilterrepo/


# Dumps privados na raiz (PII / filter-repo). Skills e orquestrador versionam
# o próprio `references/` — a regra antiga `references/` (qualquer profundidade)
# impedia os espelhos hosts/**/plugins/** de entrar no bundle instalado.
/references/


